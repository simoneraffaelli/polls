{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist-worker",
    "types": ["node"]
  },
  "include": [
    "src/worker/**/*.ts",
    "src/composition/seed-cli.ts",
    "src/infrastructure/config/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
