{
  "name": "polls",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.22.1 <25.0.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "worker:dev": "tsx watch src/worker/index.ts",
    "worker:build": "tsc --project tsconfig.worker.json",
    "worker:start": "node dist-worker/worker/index.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "node scripts/check-test-db-url.mjs && vitest run --config vitest.database.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate --name=change",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "format": "prettier --write src tests scripts package.json tsconfig.json tsconfig.worker.json next.config.ts postcss.config.mjs eslint.config.mjs vitest.config.mts vitest.database.config.mts drizzle.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json tsconfig.worker.json next.config.ts postcss.config.mjs eslint.config.mjs vitest.config.mts vitest.database.config.mts drizzle.config.ts playwright.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
